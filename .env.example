# Copy to .env and fill in the real password. .env is gitignored -- never commit it.
DATABASE_URL="postgresql://postgres.ozaxtmfxqfhmvtyaucde:[YOUR-PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Only used to allow the Google sign-in popup through the Content-Security-
# Policy. Must match VITE_FIREBASE_AUTH_DOMAIN in frontend/.env. Falls back
# to attemptiq.firebaseapp.com when unset.
VITE_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"

# The Firebase project id, used to verify the ID tokens the browser sends on
# authenticated API calls. Must match VITE_FIREBASE_PROJECT_ID in
# frontend/.env -- a token minted for a different project is rejected.
# Not a secret: the same value is compiled into the client bundle. Leave it
# unset and the signed-out half of the site still works; anything that needs
# an account answers 503.
FIREBASE_PROJECT_ID="your-project-id"
